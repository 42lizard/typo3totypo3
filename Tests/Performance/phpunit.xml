<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../Functional/Bootstrap.php" backupGlobals="true" cacheResult="false" colors="true"
         failOnWarning="true" failOnRisky="true" failOnNotice="true">
    <testsuites><testsuite name="Opt-in capacity acceptance"><directory suffix="Test.php">.</directory></testsuite></testsuites>
    <php><env name="TYPO3_CONTEXT" value="Testing" force="true"/><env name="typo3DatabaseDriver" value="pdo_sqlite"/></php>
</phpunit>
